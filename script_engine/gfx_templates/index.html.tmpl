    <script>
      // estados iniciales FUERA del timeline (bug detectado en el handoff original de HyperFrames)
${init_js}
      var tl = gsap.timeline({ paused: true });
${timeline_js}
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
