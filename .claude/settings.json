{
  "model": "claude-opus-5-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_git.py\"", "timeout": 30},
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/suite_rapida.py\"", "timeout": 180},
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/tope_tanda.py\"", "timeout": 30},
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_render.py\"", "timeout": 30},
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_mapa.py\"", "timeout": 30}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/md5_prompt.py\"", "timeout": 30}
        ]
      }
    ]
  }
}
