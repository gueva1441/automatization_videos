", "a_pantalla": false}, {"t": 42.46, "t_frame": 43.46, "dur": 4.333, "bloque": "ficha", "texto": "Operación Canguro, del franquismo, desde 1958", "veredicto": "no estorba", "motivo": "El bloque se ubica en la esquina superior izquierda, cubriendo parte de la estructura del barco y algunas figuras de fondo, sin tapar rostros principales.", "pasa": true, "voz": "El barco los llevaba a Australia. No iban solos: cerca de ocho mil españoles cruzaron por un acuerdo entre los dos gobiernos, y CSR, la compañía dueña de la mina, venía haciendo viajes privados a Europa para reclutar gente desde 1950. Allá los esperaban ya Ramón de Juan y Milagros Barroso, otro matrimonio que había llegado en agosto de 1962; con ellos, recuerda ella, se harían íntimos amigos.", "mira": "foto sola", "pregunta": "¿estorba?", "pool_id": "D83", "a_pantalla": false}], "sellos_tema": [], "realizador": {"filas": []}, "critico": [], "transitions": {"1": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R3"}, "2": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R1"}, "3": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R3"}, "4": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R2"}, "5": {"kind": "zoom_punch", "frames": 12, "why": "pico", "rank": "R3"}, "6": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R3"}, "7": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R3"}, "8": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R3"}, "9": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R3"}, "10": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R3"}, "11": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R2"}, "12": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R3"}, "13": {"kind": "cut", "frames": 0, "why": "corte", "rank": "R2"}, "14": {"kind": "dip", "frames": 10, "why": "cierre", "rank": "R1"}}}
