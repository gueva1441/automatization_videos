      "description": "The request was cancelled.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean",
           "description": "Whether the request was cancelled successfully."
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/fal-ai/bytedance/seedream/v5/lite/edit": {
